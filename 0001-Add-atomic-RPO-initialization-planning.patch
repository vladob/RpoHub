@@ -111,3 +119,43 @@ public sealed partial class GetRpoInitializationPreview(IRpoExportCatalog catalo
     [GeneratedRegex(@"^batch-init/init_(\d{4}-\d{2}-\d{2})_list\.txt$", RegexOptions.CultureInvariant)]
